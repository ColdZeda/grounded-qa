# grounded-qa 环境变量样例：复制成 .env 再填真实值（.env 不进 git；本机 / 服务器各一份，见 AGENTS §9.1）

# agent 模式总闸：false = 全站强制 pipeline（飞书侧不读它）
OPEN_AGENT_MODE=true

# 应用
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 本机端口整块挪到 5 万段（避开项目 #1）；容器内互访仍用标准端口，
# 应用按 host 是否回环自动选（localhost → *_HOST_PORT，postgres → *_PORT）
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=58000

# PostgreSQL（本地由 docker compose 起）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grounded_qa
POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me

# Redis（语义缓存 + BLPOP 队列）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=96mb

# 模型接入：变量名按能力命名，值可换任意 OpenAI 兼容服务
# ⚠️ 换 embedding 模型 = 必须全量重嵌入（AGENTS §7.1 约定 3）

# 对话 / 多模态（当前 DeepSeek；⚠️ base_url 要带 /v1）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# embedding（DeepSeek 不提供，必须另选一家；当前阿里云百炼）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# ⚠️ 必须与模型真实维度一致；换模型要重新实测并同步迁移（chunks.embedding 已冻结为 1024 维）
EMBEDDING_DIM=1024

# rerank（可与 embedding 同一家、同一把 Key；但必须用专门的 rerank 模型）
# ⚠️ 客户端走百炼原生 rerank 路径；模型报「路径 / 字段不对」时保底换回 gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
# 关掉精排也能跑（退回 RRF 顺序），但拒答改走余弦阈值、能力明显下降 —— 是降级，不是等价配置
RERANK_ENABLED=true

# 检索 / 生成
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RRF_K=60
# 拒答阈值：比的是 rerank 分（不是 RRF 名次）；换 rerank 模型或语料必须重标，
# 标定过程的分数分布见 docs/architecture.md §9.25
ANSWER_MIN_SCORE=0.60
# rerank 不可用时的向量余弦阈值，与上面不是一个量纲（取值理由同样见 §9.25）
ANSWER_MIN_COSINE=0.45
# 全文路（pg_trgm word_similarity）粗筛下限，刻意很低
FULLTEXT_MIN_SIMILARITY=0.05
# 带几条历史消息（1 条 = 半轮；12 ≈ 6 轮问答）
HISTORY_MESSAGES=12
MODEL_REQUEST_TIMEOUT_SECONDS=60

# 上传入库（网页上传 → Redis 队列 → mini worker）
# api 写、worker 读，容器里挂同一个卷；它只是传送带，处理完即删
UPLOAD_DIR=uploads
# 每人每分钟上传次数；上传要跑切分 + N 次 embedding 且走队列串行，所以比问答严得多
UPLOAD_RATE_LIMIT_PER_MINUTE=5
# 单文件上限（2 MB）。⚠️ nginx 的 client_max_body_size 只是兜底，开太大会被垃圾请求写满盘
UPLOAD_MAX_BYTES=2097152
# 单文档最多切多少块，超过就整篇失败（防病态输入堵住队列）
MAX_CHUNKS_PER_DOCUMENT=400
# 只读的评测报告页用这个目录（相对仓库根）
EVALS_RESULTS_DIR=evals/results

# 多租户 / 限流 / 配额（成本熔断，逻辑在 app/core/limits.py）
DEFAULT_TENANT_ID=default
# 每人每分钟提问次数（不是 token）；必须明显小于 nginx 那道按 IP 的限额
RATE_LIMIT_PER_MINUTE=30
# 每人每日 token 上限，按模型回报的 usage 累加；流式无法中途掐断，所以可能超出一条回答的量
TOKEN_QUOTA_PER_DAY=200000
# 配额页「估算成本」的单价（元 / 百万 token）；0 = 不估算，只影响展示
LLM_PRICE_PER_MILLION_TOKENS=0
# 流式回答要不要索要 usage —— 关掉的后果是配额算不出来
LLM_STREAM_USAGE=true

# 鉴权（JWT）
# ⚠️ JWT_SECRET 泄露 = 全站沦陷：至少 32 字节（HS256），生产必须换，APP_ENV != dev 时应用拒绝启动
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_HASH_ROUNDS=12

# 管理端 bootstrap（python -m app.db.seed 用一次）；⚠️ 生产必须改 ADMIN_PASSWORD，否则拒绝启动
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# 演示登录：开启后登录页出现「一键体验」，服务端 find-or-create 一个只读 member 账号
# ⚠️ 默认关，只在公网演示站开
DEMO_LOGIN_ENABLED=false

API_PREFIX=/api/v1

# 可观测
# HTTP 层指标（请求数 / 耗时）；关掉只会少这两类，业务计数器照样导出
METRICS_ENABLED=true
# 容器里写服务名；本机直跑 uvicorn 时看板会显示「取不到数据」，属预期
PROMETHEUS_URL=http://prometheus:9090
# 看板用它算「样本多旧算陈旧」（3 个周期）；⚠️ 与 deploy/prometheus/prometheus.yml 是两份配置
PROMETHEUS_SCRAPE_INTERVAL_S=30

# 告警推送（飞书 / 企微群机器人，报文格式按域名自动判断）
# 🔴 凭据：只写在服务器本机 .env；留空 = 关闭告警。改了要 up -d 才生效
ALERT_WEBHOOK_URL=
ALERT_POLL_INTERVAL_S=60

# 飞书渠道（自建应用 + 长连接，与上面的群机器人是两回事）
# 取法：开放平台 → 自建应用 → 凭证与基础信息；再添加「机器人」能力、订阅 im.message.receive_v1（长连接）、发版
# 🔴 App Secret 是凭据：不进对话 / git / 日志。改了要重启 feishu 容器
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书消息记在哪个账号名下（填邮箱；留空回落 ADMIN_EMAIL）
FEISHU_CHANNEL_EMAIL=
# 回复是否附来源编号列表；顾客侧默认关
FEISHU_SHOW_SOURCES=false
