# ============================================================
# grounded-qa · 环境变量样例
# ------------------------------------------------------------
# 用法：复制成 .env 再填真实值。**`.env` 绝不进 git**（见 .gitignore）。
#
# ⚠️ 本机（Windows 开发）与服务器**各一份独立的 .env**，
#    绝不混用、绝不同步（AGENTS.md §9.1）。
#
# ⚠️ 写文件一律 **UTF-8 无 BOM**。PowerShell 默认的 Out-File 会带 BOM，
#    会导致解析失败（AGENTS.md §10 已知坑）。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- PostgreSQL（本地由 docker compose 起，不要装到宿主机）----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grounded_qa
POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me

# ---------- Redis（语义缓存 + BLPOP 队列）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=96mb

# ============================================================
# 模型：**全部走 API，不落本地模型**（AGENTS 硬约束 §2）
# ============================================================

# ---------- 对话 / 多模态：智谱免费档 ----------
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ---------- embedding / rerank：百炼 ----------
# ⚠️ EMBEDDING_MODEL / EMBEDDING_DIM 是**元数据锁**：
#    换模型必须全量重嵌入，否则检索质量会**静默变差**（AGENTS §7.1 约定 3）。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2

# ============================================================
# 检索 / 生成：所有可调项走配置，不硬编码（AGENTS §7.1 约定 11）
# ============================================================
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RRF_K=60
# 低于该置信度直接**拒答**，不要硬答
ANSWER_MIN_SCORE=0.35

# ---------- 多租户 / 限流 / 配额 ----------
DEFAULT_TENANT_ID=default
RATE_LIMIT_PER_MINUTE=30
TOKEN_QUOTA_PER_DAY=200000

# ---------- 管理端（独立鉴权）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---------- 可观测 ----------
METRICS_ENABLED=true
