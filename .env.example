# ============================================================
# grounded-qa · 环境变量样例
# ------------------------------------------------------------
# 用法：复制成 .env 再填真实值。**`.env` 绝不进 git**（见 .gitignore）。
#
# ⚠️ 本机（Windows 开发）与服务器**各一份独立的 .env**，
#    绝不混用、绝不同步（AGENTS.md §9.1）。
#
# ⚠️ 写文件一律 **UTF-8 无 BOM**。PowerShell 默认的 Out-File 会带 BOM，
#    会导致解析失败（AGENTS.md §10 已知坑）。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ============================================================
# 本机端口规划 —— ⚠️ 必读：本机还有项目 #1，端口必须错开
# ------------------------------------------------------------
# 本机同时跑着项目 #1（langgraph-mcp-code-agent），它的依赖栈占了
#     3307（MySQL）/ 6379（Redis）/ 8888（SearXNG）/ 80（nginx）
# 所以本项目**不用那些默认端口**，整块挪到 5 万段：
#
#     服务          宿主机端口    容器内端口
#     PostgreSQL    55432        5432
#     Redis         56379        6379
#     API           58000        8000
#
# 下面的 POSTGRES_PORT / REDIS_PORT 是**容器内互访**用的标准端口；
# 从宿主机连（psql / redis-cli / GUI 工具）请用带 _HOST_PORT 的那三个。
# ============================================================
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=58000

# ---------- PostgreSQL（本地由 docker compose 起，不要装到宿主机）----------
POSTGRES_HOST=localhost
# ⚠️ **容器内互访**端口。容器网络里就是标准的 5432。
POSTGRES_PORT=5432
# ⚠️ **宿主机侧**端口 —— compose 把容器的 5432 映射到这里。
#    在 Windows 上直接跑 `uv run alembic ...` / `uv run pytest` / GUI 工具时用的是**这个**。
#    应用自己会判断：host 是回环地址（localhost）→ 用 HOST_PORT；是服务名（postgres）→ 用 PORT。
#    所以**不需要**为了让宿主机工具连上而改 POSTGRES_PORT。
POSTGRES_HOST_PORT=55432
POSTGRES_DB=grounded_qa
POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me

# ---------- Redis（语义缓存 + BLPOP 队列）----------
REDIS_HOST=localhost
# ⚠️ 容器内端口；从宿主机连用 REDIS_HOST_PORT（56379）
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=96mb

# ============================================================
# 模型接入
# ------------------------------------------------------------
# ⚠️ **本文件不绑定任何厂商**：变量名是**能力导向**的（LLM_* / EMBEDDING_* / RERANK_*），
#    值全部可以换成任意 OpenAI 兼容服务。下面填的只是**当前选用的示例**，随时可换。
#
# ⚠️ 例外：**embedding 换模型 = 必须全量重嵌入**（AGENTS §7.1 约定 3）。
#    改了 EMBEDDING_MODEL / EMBEDDING_DIM 必须同步迁移，否则检索质量会**静默变差**。
# ============================================================

# ---------- 对话 / 多模态（任意 OpenAI 兼容端点）----------
# 当前：DeepSeek · https://platform.deepseek.com/api_keys
#       模型 `deepseek-flash`（快 / 便宜）或 `deepseek-v4-pro`（强）
# 也可换：智谱 https://open.bigmodel.cn/api/paas/v4（glm-4-flash 免费档）等
# ⚠️ base_url **要带 /v1** —— 客户端拼的是 `{base}/chat/completions`。
#    DeepSeek 两种写法都认，但写全了换到只认 /v1 的服务时不会踩坑。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---------- embedding ----------
# ⚠️ **DeepSeek 不提供 embedding**（只有对话模型），所以这一项**必须另选一家**。
# 当前：阿里云百炼 · https://bailian.console.aliyun.com/ → API-KEY 管理
#       模型 qwen3.7-text-embedding-flash
# 备选：硅基流动 https://api.siliconflow.cn/v1（BAAI/bge-m3 等）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# ⚠️ 必须和模型的真实维度一致。
#    ✅ **已实测确认**（2026-10-15 打了一次真实请求）：`qwen3.7-text-embedding-flash`
#       返回 **1024 维**，与下面这个配置、与迁移里冻结的 `chunks.embedding Vector(1024)`
#       **三者一致** → 不用改列、也不用迁移。
#    ⚠️ 换 embedding 模型后必须**重新实测维度**；不符就要改这里 ＋ 一条
#       `ALTER COLUMN ... TYPE vector(N)` 迁移（届时库里已有向量，代价比现在大得多）。
EMBEDDING_DIM=1024

# ---------- rerank（精排）----------
# 可以和 embedding **共用同一家 / 同一把 Key**（推荐，少管一个凭据），
# 但**必须用专门的 rerank 模型** —— embedding 当不了 rerank（见计划书 §4.2）
# 当前：阿里云百炼 · qwen3.7-text-rerank
#       ⚠️ **保底 `gte-rerank-v2`** —— `RerankClient` 写死的是百炼**原生** rerank 路径
#          （`{base}/services/rerank/text-rerank/text-rerank`），那是照着 gte 的形状写的。
#          新模型若报"路径 / 字段不对"，把这一行换回 `gte-rerank-v2` 即可，**代码不用动**。
#          ⚠️ **但换回去之后 `ANSWER_MIN_SCORE` 也必须重标**（两者分布完全不同，
#             见下面 ANSWER_MIN_SCORE 那段）—— 不重标就会**全拒答**。启动时会打告警。
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
# 关掉 rerank 也能跑（精排是锦上添花，挂了就退回 RRF 顺序），
# ⚠️ **但关掉之后拒答会改用另一套阈值 `ANSWER_MIN_COSINE`** —— 两者分布不同，
#    拿 rerank 的阈值去比余弦会**误拒大部分可答题**。启动时会打告警。
RERANK_ENABLED=true

# ============================================================
# 检索 / 生成：所有可调项走配置，不硬编码（AGENTS §7.1 约定 11）
# ============================================================
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RRF_K=60
# 低于该置信度直接**拒答**，不要硬答
# ⚠️ 这个阈值比的是 **rerank 分数**。rerank 不可用时的余弦阈值是**另一个**键
#    （`ANSWER_MIN_COSINE`）—— 两种分数不是同一个量纲，一套阈值必然在一种口径上是错的。
#    **绝不能拿 RRF 分数来比** —— RRF 是名次的函数，库里只有一条不相关内容时它照样排第一。
# ⚠️ **它和上面的 `RERANK_MODEL` 是一对，必须一起改** ——
#    分数的分布跟着模型走，换一个留一个 = **静默地全拒答或全放行**。
#    应用启动时会自检这一对是否配套（`app/core/config.py::warn_if_rerank_calibration_missing`）。
# ⚠️ **这个值是实测校准出来的，不是拍的**（2026-10-15，`qwen3.7-text-rerank`，20 条样本）：
#      相关 11 条 → 0.786 ~ 0.990 ｜ 无关 9 条 → 0.009 ~ 0.466  ← **完全分离，中间空了 0.32**
#      取 0.60：两侧余量 0.13 / 0.19。
#      ⚠️ 取 0.35 会**误答 4/9** —— "今天天气怎么样？" 拿到 0.466 就直接被答了。
#    📌 **换 rerank 模型、或换语料之后都必须重新校准** —— 分数分布跟着这两者走。
#       （旧值 0.35 是照 `gte-rerank-v2` 定的；那个模型同一批数据最高才 0.17，用 0.35 会**全拒答**。）
#    📌 重标完，**把新模型名加进 `app/core/config.py` 的 `CALIBRATED_RERANK_MODELS`** ——
#       那是"校准记录"，不加的话下次启动会一直告警。
ANSWER_MIN_SCORE=0.60
# **rerank 不可用时**用来比**向量余弦**的阈值。⚠️ 和 ANSWER_MIN_SCORE 不是一回事。
# 实测（2026-10-17，B 库 35 篇/231 块）：可答 25 题余弦 0.409~0.688 ／ 不可答 13 题 0.352~0.578
#   ⟹ **重叠区 0.409~0.578，几乎分不开**。若沿用 0.60 → **误拒 19/25 个可答题**。
# 取 0.45：正确拒答 8/13、误拒可答 1/25 —— **故意偏向"宁可放过"**（误拒比漏拒更伤体验）。
# 📌 含义：**rerank 关掉时拒答能力显著下降**，这是降级，不是等价配置。
ANSWER_MIN_COSINE=0.45
# 全文路（pg_trgm word_similarity）的粗筛下限。刻意很低：这一步只做粗筛。
FULLTEXT_MIN_SIMILARITY=0.05
# 多轮对话带几条历史消息
HISTORY_MESSAGES=6
# 外部模型 API 超时（秒）
MODEL_REQUEST_TIMEOUT_SECONDS=60

# ============================================================
# 上传入库（网页上传 → Redis 队列 → mini worker）
# ============================================================
# 上传文件的**停放目录**。api 写、worker 读，所以容器里必须挂**同一个卷**
# （compose 里是 `gq-uploads` → `/app/uploads`）。
# ⚠️ 它只是**传送带**：worker 处理完就删。长期数据是切好的块（`chunks` 表）。
# ⚠️ 本地直接跑 uvicorn/worker 时是**相对 cwd** 的路径，已在 .gitignore 里排除。
UPLOAD_DIR=uploads
# 每个用户每分钟能**上传**几次。比问答严得多：一次上传要跑一遍切分 ＋ N 次 embedding，
# 而且它走**队列串行**处理 —— 一个人连传 20 个文件会把队列堵住，别人只能干等。
UPLOAD_RATE_LIMIT_PER_MINUTE=5
# 单个文件上限（字节）。默认 2 MB —— 知识库语料是散文，2 MB 已经是一本小册子。
# ⚠️ nginx 那边还有一道 `client_max_body_size`（4m），**它只是兜底**：
#    nginx 会先把请求体落盘，上限开太大等于允许别人用垃圾请求写满磁盘。
UPLOAD_MAX_BYTES=2097152
# 单文档最多切多少块，超过就**整篇失败**（不做部分入库）。
# ⚠️ 治病态输入：没有任何换行的 1 MB 文本能切出上千块 = 上千次 embedding 请求，
#    会把队列堵住半小时。宁可整篇失败、让用户看见原因，也不要"只进了一半"。
MAX_CHUNKS_PER_DOCUMENT=400
# 评测结果 JSON 的目录（只读报告页用）。**相对仓库根**解析。
# ⚠️ 这些文件属于「报告数据」，进镜像；题集与 runner 不进（服务器不跑评测）。
EVALS_RESULTS_DIR=evals/results

# ---------- 多租户 / 限流 / 配额（**成本熔断**，逻辑在 `app/core/limits.py`）----------
DEFAULT_TENANT_ID=default
# 每个用户每分钟能发几**次**问答。⚠️ 比的是次数，不是 token。
# ⚠️ 必须**明显小于** nginx 那道按 IP 的限额（`deploy/nginx` 里 120r/m）——
#    写反了用户会先撞上 nginx 的 HTML 错误页，而不是我们那条说得出"还有几秒"的 JSON。
RATE_LIMIT_PER_MINUTE=30
# 每个用户每天能烧多少 token。**模型 API 回报的 usage 累加，不是估算**。
# 200k ≈ 一天几百次问答。⚠️ 这是**成本熔断**：流式回答没法中途掐断，所以是"这次跑完记账、
# 下次进来才拒"，实际用量可能略超（最多一条回答的量）。拒答不调模型 ⟹ 记 0。
TOKEN_QUOTA_PER_DAY=200000
# 配额页上"估算成本"用的单价（元 / 百万 token）。
# ⚠️ 默认 0 = **不估算**（各家价格会变，写死一个数字比不给更糟）。
# 配了之后页面会多显示一个"估算 ¥x.xx"，**并把这个单价一起印出来** —— 成本数字必须可解释。
# 只影响**展示**，不影响任何限流 / 熔断逻辑。
LLM_PRICE_PER_MILLION_TOKENS=0
# 流式回答里要不要顺带要一份 `usage`（token 计量靠它）。
# ⚠️ 实测 `deepseek-flash` 支持。关掉的后果不是"少一个指标"，而是**配额算不出来**——
#    真遇到不兼容的端点时宁可选它，也别选"全站 400"。
LLM_STREAM_USAGE=true

# ============================================================
# 鉴权（JWT）
# ------------------------------------------------------------
# ⚠️ **JWT_SECRET 是"能签发任意身份"的钥匙**，泄露 = 全站沦陷。
#    · 至少 **32 字节**（HS256 的硬性要求，RFC 7518 §3.2）—— 短了 PyJWT 会一直警告
#    · 生产必须换掉；`APP_ENV != dev` 时应用会**拒绝启动**（见 config.py 的启动校验）
#    · 生成一个：`python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
# 登录有效期（分钟）。720 = 12 小时。
ACCESS_TOKEN_EXPIRE_MINUTES=720
# bcrypt 轮数。12 是常见取值；调高更安全但登录更慢。
PASSWORD_HASH_ROUNDS=12

# ---------- 管理端 bootstrap（`python -m app.db.seed` 用一次）----------
# ⚠️ 生产必须改掉 ADMIN_PASSWORD，否则应用**拒绝启动**。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- 演示登录（走查阶段 P0-③）----------
# 打开后登录页出现「一键体验（演示账号）」：服务端 find-or-create 一个 **member**
# 身份的演示账号并签发 token（账号密码都不存在，前端也不保存任何凭据）。
# ⚠️ 默认 false。只有在"公网演示站"才打开 —— 打开意味着任何访客都能进来提问
#    （仍受每用户「每分钟次数 / 每日 token」两道限制）。
DEMO_LOGIN_ENABLED=false

# ---------- API ----------
API_PREFIX=/api/v1

# ---------- 可观测 ----------
# HTTP 层指标（请求数 / 耗时）与 `/metrics`。关掉只会少这两类指标，
# 业务计数器（token / 限流 / 向量漂移）照样导出 —— 所以默认开着，别关。
METRICS_ENABLED=true
# 运维看板去问哪台 Prometheus。**容器里写服务名**（compose 网络内解析）。
# 本机直跑 uvicorn 时这个名字不存在 ⟹ 看板显示"取不到数据 + 原因"，这是预期行为。
PROMETHEUS_URL=http://prometheus:9090
# Prometheus 的抓取周期（秒），看板用它算"样本多旧算陈旧"（3 个周期）。
# ⚠️ 与 `deploy/prometheus/prometheus.yml` 的 `scrape_interval` 是两份配置，改一处要改两处。
PROMETHEUS_SCRAPE_INTERVAL_S=30

# ---------- 告警推送（v1.1）----------
# 群机器人地址：飞书（域名含 open.feishu.cn）或企微（含 qyapi.weixin.qq.com）都行 ——
# **报文格式按 URL 域名自动判断**，不用选。
# ⚠️ **留空 = 关闭告警**：只打一行「告警未配置」日志，不轮询、不报错，其余功能照旧。
# 🔴 **这是凭据**：谁拿到都能往你群里发消息。只写在服务器本机的 `.env` 里，
#    **不进对话、不进 git、不进日志**（代码里也只读不打印）。
# ⚠️ 改了这个值要 `docker compose up -d api` 才生效 —— 环境变量是**进程启动时**的快照。
ALERT_WEBHOOK_URL=
# 搬运工轮询周期（秒）。它读 Prometheus 的 `/api/v1/alerts`；60 秒够了 ——
# 告警本身以分钟计，问得更勤只是多打无用查询。
ALERT_POLL_INTERVAL_S=60

# ---------- 飞书渠道（v1.2 第①项）----------
# 🔴 **和上面的 webhook 是两回事**：
#    · `ALERT_WEBHOOK_URL` = 群机器人 webhook，**只能发**（告警用，收不到用户消息）
#    · 下面这组 = **自建应用 ＋ 长连接**，能收发（用户私聊机器人 → 我们回答）
#
# 怎么拿：飞书开放平台 → 创建企业自建应用 → 凭证与基础信息 → 复制 App ID / App Secret；
#   然后在这个应用里 ① 添加「机器人」能力；② 事件订阅里订阅 `im.message.receive_v1`
#   （**选长连接模式，不用填请求地址**）；③ 发布版本，把应用拉进一个群或直接私聊它。
#
# 🔴 **App Secret 是凭据**：只写 `.env`，**不进对话、不进 git、不进日志**。
# ⚠️ 改任何一个都要重启（`docker compose up -d feishu`）—— 环境变量是进程启动时的快照。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书消息统一记在哪个账号名下（填**邮箱**，必须是库里已有的用户）。
# ⚠️ v1.2 先接一个"渠道账号"：`open_id → 用户` 的映射表要管理界面和权限设计，那是另一件事。
#    留空 = 回落到 `ADMIN_EMAIL`（演示够用；生产该给它一个独立的成员账号）。
FEISHU_CHANNEL_EMAIL=
# 回复里要不要附引用来源（纯文本编号列表）。飞书里点不了 `[1]`，所以给文字版。
FEISHU_SHOW_SOURCES=true
